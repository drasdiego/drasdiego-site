# ============================================================
# Gemini API key for the hybrid AI assistant (OPTIONAL).
# Get one at https://aistudio.google.com/apikey
# - If unset, the assistant works fully with the local knowledge base.
# - Set this in Vercel: Project → Settings → Environment Variables.
# ============================================================
GEMINI_API_KEY=

# ============================================================
# Chat models, in order of preference (OPTIONAL, comma separated, up to 3).
# If the first model is overloaded or slow, the next one is tried,
# and the local knowledge base answers when all of them fail.
# Default: gemini-3.6-flash,gemini-3.1-flash-lite
# ============================================================
GEMINI_CHAT_MODELS=
# ============================================================
# Anthropic API key and model for the chat (OPTIONAL).
# When set, the chat tries Claude first, then Gemini, then the local base.
# Default model: claude-haiku-5-5
# ============================================================
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=
