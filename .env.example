# ============================================================
# Anthropic API key and model for the chat (OPTIONAL).
# - If unset, the assistant works fully with the local knowledge base.
# - When set, the chat uses Claude and falls back to the local base if it fails.
# - Set this in Vercel: Project > Settings > Environment Variables.
# Default model: claude-haiku-5-5
# ============================================================
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=

# ============================================================
# Contact form webhook (OPTIONAL).
# - URL that receives the contact form messages (for example, a Google Apps Script web app).
# - Shared secret sent in the request body and checked by the webhook.
# - If unset, /api/contato answers 503 and the page suggests LinkedIn.
# ============================================================
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
